{
  "name": "wheels-off",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:itch": "tsc -b && VITE_PORTAL=itch vite build --outDir dist-itch --emptyOutDir && node scripts/portal-zip.mjs dist-itch wheels-off-itch.zip",
    "build:crazygames": "tsc -b && VITE_PORTAL=crazygames vite build --outDir dist-crazygames --emptyOutDir && node scripts/portal-zip.mjs dist-crazygames wheels-off-crazygames.zip",
    "media:crazygames": "node scripts/preview-media.mjs",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "api": "wrangler dev --port 8788",
    "db:migrate": "wrangler d1 migrations apply wheels-off --local"
  },
  "dependencies": {
    "@pixiv/three-vrm": "3.5.5",
    "@react-three/drei": "10.7.7",
    "@react-three/fiber": "9.6.1",
    "@rive-app/react-canvas": "4.29.1",
    "maath": "0.10.8",
    "react": "~19.2.7",
    "react-dom": "~19.2.7",
    "three": "0.184.0",
    "zustand": "5.0.14"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261008.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@types/three": "0.184.1",
    "@vitejs/plugin-react": "6.0.2",
    "playwright-core": "1.60.0",
    "typescript": "6.0.3",
    "vite": "8.0.16",
    "wrangler": "4.148.0"
  }
}
